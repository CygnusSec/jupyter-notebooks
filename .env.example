# JupyterHub Self-Host Configuration
# Copy this file to .env and modify values as needed.

# ========== Hub Settings ==========

# Port for JupyterHub web interface
# Valid: integer 1024–65535
HUB_PORT=8000

# Admin users (comma-separated, have terminal + user management)
ADMIN_USERS=admin

# Admin password (auto-created on first startup)
# WARNING: Change this to a strong password in production
ADMIN_PASSWORD=changeme123

# Allow new user signup (set to false after initial setup)
ALLOW_SIGNUP=true

# ========== User Container Limits ==========

# Memory limit per user container
# Valid: integer followed by G or M (e.g., 4G, 2048M)
USER_MEM_LIMIT=4G

# CPU limit per user container
# Valid: decimal number 0.5–16.0
USER_CPU_LIMIT=2.0

# ========== GitHub Integration ==========

# GitHub Personal Access Token (for jupyterlab-github extension)
# Generate at: https://github.com/settings/tokens
GITHUB_ACCESS_TOKEN=
